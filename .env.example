# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# Painel: Project Settings > API.
#
# SUPABASE_SERVICE_ROLE_KEY é segredo: fica só no servidor. Nunca coloque no frontend
# nem no repositório.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional
PORT=3000
